# Production settings for docker-compose.prod.yml (docs/deployment.md).
#   cp .env.production.example .env.production
# Then fill in every value. NEVER commit .env.production, and keep a copy in a password
# manager: without DEVICE_SECRETS_KEY a restored backup cannot read the devices' passwords.
#
# Generate each secret with (letters, digits, - and _ only, safe inside a URL):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# or, without Node:
#   openssl rand -base64 48 | tr '+/' '-_' | tr -d '='

# Address people open in the browser (no trailing slash). Also the link in emails.
PUBLIC_URL=https://asistencia.empresa.com
# Port nginx listens on, on this server.
HTTP_PORT=80
# true when PUBLIC_URL is https (tunnel or proxy). false ONLY on a closed LAN over plain HTTP.
COOKIE_SECURE=true
# Company time zone (IANA name): work days, reports and the daily jobs follow it.
APP_TIMEZONE=America/Guayaquil

POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# 32 random bytes in base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   openssl rand -base64 32
DEVICE_SECRETS_KEY=

# How often the server reads the devices, in seconds.
DEVICE_SYNC_INTERVAL_SECONDS=300

# Email notifications (optional; docs/adr/0011-email-notifications.md).
# SMTP_URL=smtps://avisos%40empresa.com:app-password@smtp.empresa.com:465
# MAIL_FROM=AsistControl <avisos@empresa.com>

# Image tag to run (local = built on this server).
VERSION=local
