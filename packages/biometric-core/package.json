{
  "name": "@asistcontrol/biometric-core",
  "version": "0.1.0",
  "private": true,
  "description": "Abstracción de dispositivos biométricos (patrón Adapter) y simulador Mock",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/probe-cli.ts --format cjs,esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@asistcontrol/shared": "0.1.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "vitest": "^5.0.1"
  }
}
