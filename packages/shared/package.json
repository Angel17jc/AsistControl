{
  "name": "@asistcontrol/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Contratos compartidos entre API y frontend: enums de dominio, RBAC y eventos en tiempo real",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "vitest": "^3.2.0"
  }
}
