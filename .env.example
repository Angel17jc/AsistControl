# Overrides for docker-compose.yml. Copy to .env and adjust. Never commit the real .env.

# ── Ports on the host
WEB_PORT=8080
API_PORT=3000
POSTGRES_PORT=5432

# ── Database
POSTGRES_USER=asistcontrol
POSTGRES_PASSWORD=asistcontrol
POSTGRES_DB=asistcontrol

# ── Runtime mode. production = placeholder secrets are rejected and demo seed is disabled.
NODE_ENV=development
SEED_DEMO_DATA=true
ENABLE_MOCK_DEVICES=true

# ── Secrets (generate real ones for any shared environment)
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-local-access-secret-0123456789abcdef
JWT_REFRESH_SECRET=change-me-local-refresh-secret-0123456789abcdef
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DEVICE_SECRETS_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# true when served over HTTPS
COOKIE_SECURE=false

# ── Business
APP_TIMEZONE=America/Guayaquil
DEVICE_SYNC_INTERVAL_SECONDS=300
