# ── Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# pretty (human readable, local) | json (containers / log collectors)
LOG_FORMAT=pretty
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# ── Database
DATABASE_URL=postgresql://asistcontrol:asistcontrol@localhost:5432/asistcontrol?schema=public

# ── Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_REFRESH_TTL_SECONDS=604800
# Set to true behind HTTPS so the refresh cookie is only sent over TLS
COOKIE_SECURE=false

# ── Devices
# 32-byte key, base64 encoded. Encrypts device credentials at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DEVICE_SECRETS_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# Periodic polling of enabled devices. 0 disables the scheduler.
DEVICE_SYNC_INTERVAL_SECONDS=300
# Enables the MOCK driver and the /simulate endpoints (always disabled when NODE_ENV=production unless forced)
ENABLE_MOCK_DEVICES=true

# ── Business
# Default company timezone used to interpret schedules (IANA name)
APP_TIMEZONE=America/Guayaquil

# ── Rate limiting (requests per window)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
